{
  "name": "@gyga-browser/webmcp-cli",
  "version": "0.2.0",
  "description": "Preview dispatcher for WebMCP top-level commands (local MVP, no public webmcp bin).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "webmcp-cli": "bin/webmcp-cli.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='lib/**/*.mjs' --test-coverage-include='bin/*.mjs' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=75 --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
